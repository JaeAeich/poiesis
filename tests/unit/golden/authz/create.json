{
  "case": "7",
  "description": "Poiesis CreateTask: stripped URLs, no backend_parameters, command, env or content; allowlist [eduperson_entitlement]",
  "expect": {
    "reference_policy": {
      "decision": true
    }
  },
  "name": "poiesis-create",
  "request": {
    "action": {
      "name": "CreateTask",
      "properties": {}
    },
    "context": {
      "tes": {
        "profile": "tes-authzen/1",
        "service_id": "org.ga4gh.poiesis"
      }
    },
    "resource": {
      "id": "own",
      "properties": {
        "task": {
          "executors": [
            {
              "image": "docker.io/library/alpine:3.20"
            }
          ],
          "inputs": [
            {
              "path": "/data/in.txt",
              "type": "FILE",
              "url": "s3://bucket/in.txt"
            },
            {
              "path": "/data/inline.txt",
              "type": "FILE"
            }
          ],
          "name": "hello",
          "outputs": [
            {
              "path": "/data/out",
              "type": "DIRECTORY",
              "url": "https://storage.example.org/out/"
            }
          ],
          "resources": {
            "cpu_cores": 1,
            "disk_gb": 5.0,
            "preemptible": false,
            "ram_gb": 1.0,
            "zones": []
          },
          "tags": {
            "project": "demo"
          },
          "volumes": [
            "/vol/a"
          ]
        }
      },
      "type": "tes_task_set"
    },
    "subject": {
      "id": "{{subject_id}}",
      "properties": {
        "claims": {
          "eduperson_entitlement": [
            "urn:geant:lifescience-ri.eu:group:example-vo:analysts#login.aai.lifescience-ri.eu"
          ]
        },
        "client_id": "{{client_id}}",
        "iss": "{{iss}}",
        "scope": [
          "openid",
          "eduperson_entitlement"
        ],
        "sub": "{{sub}}",
        "via": "oidc"
      },
      "type": "user"
    }
  },
  "submit": {
    "executors": [
      {
        "command": [
          "echo",
          "secret"
        ],
        "env": {
          "TOKEN": "do-not-send"
        },
        "image": "docker.io/library/alpine:3.20"
      }
    ],
    "id": "client-chosen-id",
    "inputs": [
      {
        "path": "/data/in.txt",
        "type": "FILE",
        "url": "s3://bucket/in.txt?X-Amz-Signature=do-not-send"
      },
      {
        "content": "do-not-send",
        "path": "/data/inline.txt",
        "type": "FILE"
      }
    ],
    "name": "hello",
    "outputs": [
      {
        "path": "/data/out",
        "type": "DIRECTORY",
        "url": "https://user:do-not-send@storage.example.org/out/"
      }
    ],
    "resources": {
      "backend_parameters": {
        "secret": "do-not-send"
      },
      "cpu_cores": 1,
      "disk_gb": 5.0,
      "preemptible": false,
      "ram_gb": 1.0,
      "zones": []
    },
    "state": "COMPLETE",
    "tags": {
      "project": "demo"
    },
    "volumes": [
      "/vol/a"
    ]
  }
}
