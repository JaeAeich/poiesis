{
  "job": {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden",
      "namespace": "poiesis"
    },
    "spec": {
      "activeDeadlineSeconds": 3600,
      "backoffLimit": 0,
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/component": "taskpod",
            "app.kubernetes.io/name": "poiesis",
            "poiesis.io/task": "golden"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "requiredDuringSchedulingIgnoredDuringExecution": {
                "nodeSelectorTerms": [
                  {
                    "matchExpressions": [
                      {
                        "key": "arch",
                        "operator": "In",
                        "values": [
                          "amd64"
                        ]
                      },
                      {
                        "key": "topology.kubernetes.io/zone",
                        "operator": "In",
                        "values": [
                          "us-east1-b"
                        ]
                      }
                    ]
                  },
                  {
                    "matchExpressions": [
                      {
                        "key": "topology.kubernetes.io/zone",
                        "operator": "In",
                        "values": [
                          "us-east1-b"
                        ]
                      }
                    ],
                    "matchFields": [
                      {
                        "key": "metadata.name",
                        "operator": "NotIn",
                        "values": [
                          "n1"
                        ]
                      }
                    ]
                  }
                ]
              }
            },
            "podAntiAffinity": {
              "preferredDuringSchedulingIgnoredDuringExecution": []
            }
          },
          "automountServiceAccountToken": false,
          "containers": [
            {
              "command": [
                "poiesis",
                "ack",
                "run",
                "--task-id",
                "golden"
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "ack",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            }
          ],
          "initContainers": [
            {
              "command": [
                "poiesis",
                "trec",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [
                {
                  "name": "POIESIS_POD_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                },
                {
                  "name": "POIESIS_POD_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                }
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "trec",
              "restartPolicy": "Always",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                  "name": "kube-api-token",
                  "readOnly": true
                }
              ]
            },
            {
              "command": [
                "echo",
                "hi"
              ],
              "image": "busybox:1.36",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-0",
              "resources": {
                "limits": {
                  "amd.com/gpu": "2",
                  "cpu": "8",
                  "memory": "64Gi"
                },
                "requests": {
                  "cpu": "8",
                  "memory": "64Gi"
                }
              },
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                }
              ]
            },
            {
              "command": [
                "echo",
                "hi"
              ],
              "image": "busybox:1.36",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-1",
              "resources": {
                "limits": {
                  "amd.com/gpu": "2",
                  "cpu": "8",
                  "memory": "64Gi"
                },
                "requests": {
                  "cpu": "8",
                  "memory": "64Gi"
                }
              },
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                }
              ]
            }
          ],
          "nodeSelector": {
            "cloud.google.com/gke-spot": "true",
            "disk": "nvme",
            "poiesis.io/workload": "tasks",
            "pool": "highmem"
          },
          "priorityClassName": "tasks-high",
          "restartPolicy": "Never",
          "runtimeClassName": "gvisor",
          "terminationGracePeriodSeconds": 30,
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "tasks",
              "operator": "Exists"
            },
            {
              "key": "cloud.google.com/gke-spot",
              "operator": "Equal",
              "value": "true"
            },
            {
              "key": "highmem",
              "operator": "Exists"
            }
          ],
          "volumes": [
            {
              "name": "task-data",
              "persistentVolumeClaim": {
                "claimName": "task-golden-data"
              }
            },
            {
              "name": "kube-api-token",
              "projected": {
                "defaultMode": 420,
                "sources": [
                  {
                    "serviceAccountToken": {
                      "expirationSeconds": 3600,
                      "path": "token"
                    }
                  },
                  {
                    "configMap": {
                      "items": [
                        {
                          "key": "ca.crt",
                          "path": "ca.crt"
                        }
                      ],
                      "name": "kube-root-ca.crt"
                    }
                  },
                  {
                    "downwardAPI": {
                      "items": [
                        {
                          "fieldRef": {
                            "apiVersion": "v1",
                            "fieldPath": "metadata.namespace"
                          },
                          "path": "namespace"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "ttlSecondsAfterFinished": 3600
    }
  },
  "pvc": {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden-data",
      "namespace": "poiesis"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "1Gi"
        }
      }
    }
  }
}
