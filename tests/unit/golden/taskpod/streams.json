{
  "job": {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden",
      "namespace": "poiesis"
    },
    "spec": {
      "activeDeadlineSeconds": 3600,
      "backoffLimit": 0,
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/component": "taskpod",
            "app.kubernetes.io/name": "poiesis",
            "poiesis.io/task": "golden"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "command": [
                "poiesis",
                "ack",
                "run",
                "--task-id",
                "golden"
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "ack",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            }
          ],
          "initContainers": [
            {
              "command": [
                "poiesis",
                "trec",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [
                {
                  "name": "POIESIS_POD_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                },
                {
                  "name": "POIESIS_POD_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                },
                {
                  "name": "POIESIS_EXECUTOR_STREAMS",
                  "value": "{\"0\":{\"stderr\":null,\"stdout\":\"/transfer/data/out/stdout.txt\"},\"1\":{\"stdout\":\"/transfer/data/out/d\"},\"2\":{\"stderr\":null}}"
                }
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "trec",
              "restartPolicy": "Always",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                  "name": "kube-api-token",
                  "readOnly": true
                }
              ]
            },
            {
              "command": [
                "poiesis",
                "tif",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "tif",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                }
              ]
            },
            {
              "command": [
                "/bin/sh",
                "-c",
                "# poiesis: stdin stdout stderr\n[ -d \"$4\" ] || mkdir -p -- \"$4\"\n[ -d \"$5\" ] || mkdir -p -- \"$5\"\ni=$1 o=$2 e=$3\nshift 5\nexec \"$@\" <\"$i\" >\"$o\" 2>\"$e\"",
                "sh",
                "/data/in.txt",
                "/data/out/stdout.txt",
                "/var/log/stderr.txt",
                "/data/out",
                "/var/log",
                "cat"
              ],
              "image": "busybox",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-0",
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/data/in.txt",
                  "name": "task-data",
                  "subPath": "data/in.txt"
                },
                {
                  "mountPath": "/data/out",
                  "name": "task-data",
                  "subPath": "data/out"
                }
              ]
            },
            {
              "command": [
                "/bin/sh",
                "-c",
                "# poiesis: stdout\n[ -d \"$2\" ] || mkdir -p -- \"$2\"\no=$1\nshift 2\nexec \"$@\" >\"$o\"",
                "sh",
                "/data/out/d",
                "/data/out",
                "date"
              ],
              "image": "busybox",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-1",
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/data/in.txt",
                  "name": "task-data",
                  "subPath": "data/in.txt"
                },
                {
                  "mountPath": "/data/out",
                  "name": "task-data",
                  "subPath": "data/out"
                }
              ]
            },
            {
              "command": [
                "/bin/sh",
                "-c",
                "# poiesis: stderr\n[ -d \"$2\" ] || mkdir -p -- \"$2\"\ne=$1\nshift 2\nexec \"$@\" 2>\"$e\"",
                "sh",
                "/var/err",
                "/var",
                "true"
              ],
              "image": "busybox",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-2",
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/data/in.txt",
                  "name": "task-data",
                  "subPath": "data/in.txt"
                },
                {
                  "mountPath": "/data/out",
                  "name": "task-data",
                  "subPath": "data/out"
                }
              ]
            },
            {
              "command": [
                "poiesis",
                "tof",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "tof",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                }
              ]
            }
          ],
          "restartPolicy": "Never",
          "terminationGracePeriodSeconds": 30,
          "volumes": [
            {
              "name": "task-data",
              "persistentVolumeClaim": {
                "claimName": "task-golden-data"
              }
            },
            {
              "name": "kube-api-token",
              "projected": {
                "defaultMode": 420,
                "sources": [
                  {
                    "serviceAccountToken": {
                      "expirationSeconds": 3600,
                      "path": "token"
                    }
                  },
                  {
                    "configMap": {
                      "items": [
                        {
                          "key": "ca.crt",
                          "path": "ca.crt"
                        }
                      ],
                      "name": "kube-root-ca.crt"
                    }
                  },
                  {
                    "downwardAPI": {
                      "items": [
                        {
                          "fieldRef": {
                            "apiVersion": "v1",
                            "fieldPath": "metadata.namespace"
                          },
                          "path": "namespace"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "ttlSecondsAfterFinished": 3600
    }
  },
  "pvc": {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden-data",
      "namespace": "poiesis"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "1Gi"
        }
      }
    }
  }
}
