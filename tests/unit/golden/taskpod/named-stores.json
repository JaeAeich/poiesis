{
  "job": {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden",
      "namespace": "poiesis"
    },
    "spec": {
      "activeDeadlineSeconds": 3600,
      "backoffLimit": 0,
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/component": "taskpod",
            "app.kubernetes.io/name": "poiesis",
            "poiesis.io/task": "golden"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "command": [
                "poiesis",
                "ack",
                "run",
                "--task-id",
                "golden"
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "ack",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              }
            }
          ],
          "initContainers": [
            {
              "command": [
                "poiesis",
                "trec",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [
                {
                  "name": "POIESIS_POD_NAME",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.name"
                    }
                  }
                },
                {
                  "name": "POIESIS_POD_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                },
                {
                  "name": "AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_ACCESS_KEY_ID",
                      "name": "poiesis-s3"
                    }
                  }
                }
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "trec",
              "restartPolicy": "Always",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
                  "name": "kube-api-token",
                  "readOnly": true
                }
              ]
            },
            {
              "command": [
                "poiesis",
                "tif",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [
                {
                  "name": "AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_ACCESS_KEY_ID",
                      "name": "poiesis-s3"
                    }
                  }
                },
                {
                  "name": "POIESIS_OBJECT_STORES",
                  "value": "[{\"name\":\"ceph\",\"provider\":\"s3\",\"buckets\":[\"lab-*\"],\"endpoint\":\"https://ceph.example.org\",\"existingSecret\":\"poiesis-ceph\"},{\"name\":\"other-project\",\"provider\":\"gcs\",\"buckets\":[\"shared\"],\"workloadIdentityProvider\":\"//iam.googleapis.com/projects/1/locations/global/workloadIdentityPools/p/providers/c\"}]"
                },
                {
                  "name": "POIESIS_OBJECT_STORE_DEFAULTS",
                  "value": "s3"
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_ACCESS_KEY_ID",
                      "name": "poiesis-ceph"
                    }
                  }
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_SECRET_ACCESS_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_SECRET_ACCESS_KEY",
                      "name": "poiesis-ceph"
                    }
                  }
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_SESSION_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_SESSION_TOKEN",
                      "name": "poiesis-ceph",
                      "optional": true
                    }
                  }
                }
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "tif",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/var/run/secrets/poiesis/identity/gcp-c5482aae8c",
                  "name": "gcp-c5482aae8c-identity-token",
                  "readOnly": true
                }
              ]
            },
            {
              "command": [
                "echo",
                "hi"
              ],
              "image": "busybox:1.36",
              "imagePullPolicy": "IfNotPresent",
              "name": "exec-0",
              "stdin": false,
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/data",
                  "name": "task-data",
                  "subPath": "data"
                }
              ]
            },
            {
              "command": [
                "poiesis",
                "tof",
                "run",
                "--task-id",
                "golden"
              ],
              "env": [
                {
                  "name": "AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_ACCESS_KEY_ID",
                      "name": "poiesis-s3"
                    }
                  }
                },
                {
                  "name": "POIESIS_OBJECT_STORES",
                  "value": "[{\"name\":\"ceph\",\"provider\":\"s3\",\"buckets\":[\"lab-*\"],\"endpoint\":\"https://ceph.example.org\",\"existingSecret\":\"poiesis-ceph\"},{\"name\":\"other-project\",\"provider\":\"gcs\",\"buckets\":[\"shared\"],\"workloadIdentityProvider\":\"//iam.googleapis.com/projects/1/locations/global/workloadIdentityPools/p/providers/c\"}]"
                },
                {
                  "name": "POIESIS_OBJECT_STORE_DEFAULTS",
                  "value": "s3"
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_ACCESS_KEY_ID",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_ACCESS_KEY_ID",
                      "name": "poiesis-ceph"
                    }
                  }
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_SECRET_ACCESS_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_SECRET_ACCESS_KEY",
                      "name": "poiesis-ceph"
                    }
                  }
                },
                {
                  "name": "POIESIS_STORE_CEPH_AWS_SESSION_TOKEN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AWS_SESSION_TOKEN",
                      "name": "poiesis-ceph",
                      "optional": true
                    }
                  }
                }
              ],
              "image": "poiesis:golden",
              "imagePullPolicy": "IfNotPresent",
              "name": "tof",
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true,
                "runAsNonRoot": true,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
              },
              "volumeMounts": [
                {
                  "mountPath": "/transfer",
                  "name": "task-data"
                },
                {
                  "mountPath": "/var/run/secrets/poiesis/identity/gcp-c5482aae8c",
                  "name": "gcp-c5482aae8c-identity-token",
                  "readOnly": true
                }
              ]
            }
          ],
          "restartPolicy": "Never",
          "terminationGracePeriodSeconds": 30,
          "volumes": [
            {
              "name": "task-data",
              "persistentVolumeClaim": {
                "claimName": "task-golden-data"
              }
            },
            {
              "name": "kube-api-token",
              "projected": {
                "defaultMode": 420,
                "sources": [
                  {
                    "serviceAccountToken": {
                      "expirationSeconds": 3600,
                      "path": "token"
                    }
                  },
                  {
                    "configMap": {
                      "items": [
                        {
                          "key": "ca.crt",
                          "path": "ca.crt"
                        }
                      ],
                      "name": "kube-root-ca.crt"
                    }
                  },
                  {
                    "downwardAPI": {
                      "items": [
                        {
                          "fieldRef": {
                            "apiVersion": "v1",
                            "fieldPath": "metadata.namespace"
                          },
                          "path": "namespace"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "name": "gcp-c5482aae8c-identity-token",
              "projected": {
                "defaultMode": 420,
                "sources": [
                  {
                    "serviceAccountToken": {
                      "audience": "https://iam.googleapis.com/projects/1/locations/global/workloadIdentityPools/p/providers/c",
                      "expirationSeconds": 3600,
                      "path": "token"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "ttlSecondsAfterFinished": 3600
    }
  },
  "pvc": {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "labels": {
        "app.kubernetes.io/component": "taskpod",
        "app.kubernetes.io/name": "poiesis",
        "poiesis.io/task": "golden"
      },
      "name": "task-golden-data",
      "namespace": "poiesis"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "1Gi"
        }
      }
    }
  }
}
