{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "taskpod",
      "app.kubernetes.io/name": "poiesis",
      "poiesis.io/task": "golden"
    },
    "name": "task-golden-data",
    "namespace": "poiesis",
    "ownerReferences": [
      {
        "apiVersion": "batch/v1",
        "blockOwnerDeletion": false,
        "controller": true,
        "kind": "Job",
        "name": "task-golden",
        "uid": "0000-uid"
      }
    ]
  },
  "spec": {
    "accessModes": [
      "ReadWriteOnce"
    ],
    "resources": {
      "requests": {
        "storage": "1Gi"
      }
    }
  }
}
