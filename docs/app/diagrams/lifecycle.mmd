    actorLineColor: "#6b7280"
    signalColor: "#6b7280"
    signalTextColor: "#1f2937"
    noteBkgColor: "#f3f4f6"
    noteBorderColor: "#6b7280"
    noteTextColor: "#1f2937"
    sequenceNumberColor: "#1f2937"
    labelBoxBkgColor: "#dddddd"
    labelBoxBorderColor: "#6b7280"
