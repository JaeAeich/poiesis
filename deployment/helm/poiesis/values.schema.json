{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "poiesis chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "migrations", "database", "auth", "api", "tctl", "taskpods"],
  "properties": {
    "global":            { "type": "object" },
    "nameOverride":      { "type": "string" },
    "fullnameOverride":  { "type": "string" },
    "commonLabels":      { "type": "object" },
    "commonAnnotations": { "type": "object" },

    "image":              { "$ref": "#/$defs/imageSpec" },
    "imagePullSecrets":   { "$ref": "#/$defs/imagePullSecretsList" },

    "podSecurityContext":       { "type": "object" },
    "containerSecurityContext": { "type": "object" },

    "podSecurityEnforce": {
      "type": "string",
      "enum": ["restricted", "baseline", "off"]
    },

    "nodeSelector":   { "type": "object" },
    "tolerations":    { "type": "array" },
    "affinity":       { "type": "object" },

    "extraEnv":          { "type": "array" },
    "extraEnvFrom":      { "type": "array" },
    "extraVolumes":      { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraManifests":    { "type": "array", "items": { "type": "string" } },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api":     { "$ref": "#/$defs/saSpec" },
        "tctl":    { "$ref": "#/$defs/saSpec" },
        "taskpod": { "$ref": "#/$defs/saSpec" }
      }
    },

    "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "enum": ["json", "text", ""] }
      }
    },

    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "existingSecretKey"],
      "properties": {
        "existingSecret":    { "type": "string", "minLength": 1 },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "caConfigmap":       { "type": "string" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minSize":               { "type": "integer", "minimum": 0 },
            "maxSize":               { "type": "integer", "minimum": 1 },
            "acquireTimeoutSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "commandTimeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },

    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "issuers"],
      "properties": {
        "enabled": { "type": "boolean" },
        "issuers": {
          "type": "array",
          "items": { "$ref": "#/$defs/issuerSpec" }
        },
        "resource": {
          "type": "string",
          "pattern": "^$|^https?://[^/\\s\"\\\\?#@{}]+(/[^\\s\"\\\\?#{}]*)?$"
        },
        "apiKeys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":     { "type": "boolean" },
            "defaultTtl":  { "type": "string", "pattern": "^[1-9][0-9]{0,5}[dh]$" },
            "maxTtl":      { "type": "string", "pattern": "^[1-9][0-9]{0,5}[dh]$" },
            "maxPerOwner": { "type": "integer", "minimum": 1 }
          }
        },
        "swaggerUi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer":   { "type": "string" },
            "clientId": { "type": "string" },
            "scopes":   { "type": "string", "minLength": 1 }
          },
          "if": { "required": ["issuer"], "properties": { "issuer": { "minLength": 1 } } },
          "then": { "required": ["clientId"], "properties": { "clientId": { "minLength": 1 } } }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "issuers": { "minItems": 1 } } }
    },

    "authz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredClaim": {
          "description": "Removed: set auth.issuers[].requiredClaim. Accepted here only so that the chart can fail with that message."
        },
        "decisionService": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url":            { "type": "string", "pattern": "^(https?://\\S+)?$" },
            "timeout":        { "type": "number", "exclusiveMinimum": 0 },
            "claims":         { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "credentialFile": { "type": "string" }
          }
        },
        "sharing":   { "type": "boolean" },
        "maxOwners": { "type": "integer", "minimum": 1 },
        "adminRead": { "type": "boolean" }
      }
    },

    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },

    "serviceInfo": {
      "description": "GA4GH service-info fields of this deployment; empty keeps the built-in value. The API checks the values at startup.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "description": { "type": "string" },
        "organization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "url":  { "type": "string", "pattern": "^(https?://\\S+)?$" }
          }
        },
        "contactUrl":       { "type": "string", "pattern": "^((https?://|mailto:)\\S+)?$" },
        "documentationUrl": { "type": "string", "pattern": "^(https?://\\S+)?$" },
        "environment":      { "type": "string" },
        "createdAt": {
          "description": "ISO 8601 date and time with a UTC offset, e.g. 2026-01-15T09:00:00Z.",
          "type": "string"
        }
      }
    },

    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":              { "type": "boolean" },
        "endpoint":             { "type": "string" },
        "region":               { "type": "string" },
        "existingSecret":       { "type": "string" },
        "roleArn":              { "type": "string" },
        "virtualHostedStyle":   { "type": "boolean" },
        "serverSideEncryption": { "enum": ["", "AES256", "aws:kms", "aws:kms:dsse"] },
        "kmsKeyId":             { "type": "string" },
        "requesterPays":        { "type": "boolean" }
      }
    },

    "gcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean" },
        "existingSecret": { "type": "string" }
      }
    },

    "azure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":        { "type": "boolean" },
        "accountName":    { "type": "string" },
        "existingSecret": { "type": "string" },
        "clientId":       { "type": "string" },
        "tenantId":       { "type": "string" }
      }
    },

    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources", "service"],
      "properties": {
        "replicas":   { "type": "integer", "minimum": 1 },
        "image":      { "$ref": "#/$defs/imageOverride" },
        "resources":  { "$ref": "#/$defs/resources" },
        "probes":     { "$ref": "#/$defs/probesSpec" },
        "service":    { "$ref": "#/$defs/serviceSpec" },
        "ingress":    { "$ref": "#/$defs/ingressSpec" },
        "pdb":        { "$ref": "#/$defs/pdbSpec" },
        "preStopSleepSeconds":           { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"]
          }
        },
        "autoscaling":{ "$ref": "#/$defs/hpaSpec" },

        "extraEnv":          { "type": "array" },
        "extraEnvFrom":      { "type": "array" },
        "extraVolumes":      { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "extraContainers":   { "type": "array" },

        "podAnnotations": { "type": "object" },
        "podLabels":      { "type": "object" },
        "nodeSelector":   { "type": "object" },
        "tolerations":    { "type": "array" },
        "affinity":       { "type": "object" }
      }
    },

    "tctl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources"],
      "properties": {
        "replicas":  { "type": "integer", "minimum": 1 },
        "unschedulableTimeoutSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "liveness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled":                { "type": "boolean" },
                "maxHeartbeatAgeSeconds": { "type": "integer", "minimum": 1 },
                "periodSeconds":          { "type": "integer", "minimum": 1 },
                "timeoutSeconds":         { "type": "integer", "minimum": 1 },
                "failureThreshold":       { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "image":     { "$ref": "#/$defs/imageOverride" },
        "resources": { "$ref": "#/$defs/resources" },

        "extraEnv":          { "type": "array" },
        "extraEnvFrom":      { "type": "array" },
        "extraVolumes":      { "type": "array" },
        "extraVolumeMounts": { "type": "array" },
        "extraContainers":   { "type": "array" },

        "podAnnotations": { "type": "object" },
        "podLabels":      { "type": "object" },
        "nodeSelector":   { "type": "object" },
        "tolerations":    { "type": "array" },
        "affinity":       { "type": "object" }
      }
    },

    "taskpods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence"],
      "properties": {
        "namespace":         { "type": "string" },
        "databaseSecret":    { "type": "string" },
        "s3Secret":          { "type": "string" },
        "outputGlobFallback": { "type": "boolean" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defaultCpuCores": { "type": ["integer", "null"], "minimum": 1 },
            "defaultRamGb":    { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "maxCpuCores":     { "type": ["integer", "null"], "minimum": 1 },
            "maxRamGb":        { "type": ["number", "null"], "exclusiveMinimum": 0 },
            "cpuLimit":        { "type": "boolean" }
          }
        },
        "nodeSelector":      { "$ref": "#/$defs/nodeSelector" },
        "tolerations":       { "$ref": "#/$defs/tolerations" },
        "affinity":          { "type": "object" },
        "priorityClassName": { "type": "string" },
        "runtimeClassName":  { "type": "string" },
        "preemptible":       { "$ref": "#/$defs/nodePlacement" },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceName": { "type": "string", "minLength": 1 },
            "maxCount":     { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "backendParameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["gpu_count", "priority_class", "node_pool"] }
            },
            "priorityClasses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "nodePools": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/nodePlacement" }
            }
          }
        },
        "fileUrlRoots": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/[^,]+$" }
        },
        "ftp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "drs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowedHosts": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[^,:/\\s]+$" }
            },
            "existingSecret": { "type": "string" }
          }
        },
        "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "systemResources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recorder": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/resources" }] },
            "filer":    { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/resources" }] },
            "ack":      { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/resources" }] }
          }
        },
        "extraEnv":          { "type": "array", "items": { "type": "object" } },
        "extraVolumes":      { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultSizeGi", "maxSizeGi", "accessModes"],
          "properties": {
            "defaultSizeGi": { "type": "integer", "minimum": 1 },
            "maxSizeGi":     { "type": "integer", "minimum": 1 },
            "storageClass":  { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadOnlyMany",
                  "ReadWriteOncePod"
                ]
              }
            },
            "labels":             { "type": "object" },
            "annotations":        { "type": "object" },
            "retainAfterSeconds": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":                { "type": "boolean" },
        "databaseEgress": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["port"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "to":   { "type": "array", "items": { "type": "object" } }
          }
        },
        "ingressFrom":            { "type": "array", "items": { "type": "object" } },
        "ingressFromPodSelector": { "type": "object" },
        "extraEgress":            { "type": "array", "items": { "type": "object" } }
      }
    },

    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image":     { "$ref": "#/$defs/imageSpec" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  },

  "$defs": {
    "claimRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name":     { "type": "string", "minLength": 1 },
        "values":   { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "anyOf": [
        { "required": ["values"],   "properties": { "values":   { "minItems": 1 } } },
        { "required": ["prefixes"], "properties": { "prefixes": { "minItems": 1 } } }
      ]
    },

    "issuerSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience"],
      "properties": {
        "issuer":         { "type": "string", "minLength": 1, "pattern": "^[^|]+$" },
        "audience": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          ]
        },
        "tokenTypes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "namespace":      { "type": "string", "minLength": 1, "pattern": "^[^|]+$" },
        "principalClaim": { "type": "string", "minLength": 1 },
        "requiredScopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredClaim": { "$ref": "#/$defs/claimRule" },
        "admin":          { "$ref": "#/$defs/claimRule" },
        "actors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "userinfo": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "jwksUri":        { "type": "string", "pattern": "^https?://\\S+$" },
        "jwksCacheTtl":   { "type": "integer", "minimum": 1 },
        "clockSkew":      { "type": "integer", "minimum": 0 },
        "timeout":        { "type": "number", "exclusiveMinimum": 0 },
        "keyMinting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clients"],
          "properties": {
            "clients": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "maxAuthAge": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "if": {
        "required": ["jwksUri"]
      },
      "then": {
        "properties": {
          "userinfo": { "properties": { "enabled": { "const": false } } }
        }
      },
      "else": {
        "properties": { "issuer": { "pattern": "^https?://[^|\\s]+$" } }
      }
    },

    "imageSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "pullPolicy"],
      "properties": {
        "registry":   { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag":        { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imageOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry":   { "type": "string" },
        "repository": { "type": "string" },
        "tag":        { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never", ""] }
      }
    },
    "imagePullSecretsList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "saSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create":      { "type": "boolean" },
        "name":        { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/$defs/resourceList" },
        "limits":   { "$ref": "#/$defs/resourceList" },
        "claims":   { "type": "array", "items": { "type": "object" } }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nodePlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": { "$ref": "#/$defs/nodeSelector" },
        "tolerations":  { "$ref": "#/$defs/tolerations" }
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "probesSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup":   { "$ref": "#/$defs/probeBlock" },
        "readiness": { "$ref": "#/$defs/probeBlock" },
        "liveness":  { "$ref": "#/$defs/probeBlock" }
      }
    },
    "probeBlock": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled":          { "type": "boolean" },
        "periodSeconds":    { "type": "integer", "minimum": 1 },
        "timeoutSeconds":   { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "serviceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type":        { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port":        { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingressSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":     { "type": "boolean" },
        "className":   { "type": "string" },
        "annotations": { "type": "object" },
        "hosts":       { "type": "array" },
        "tls":         { "type": "array" }
      }
    },
    "pdbSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":      { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "hpaSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled":                        { "type": "boolean" },
        "minReplicas":                    { "type": "integer", "minimum": 1 },
        "maxReplicas":                    { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
